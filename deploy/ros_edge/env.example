# Copy to .env on the robot. Do not commit real secrets.

# --- LLM (required for --real-llm / scenario C --image) ---
ADP_LLM_BASE_URL=https://api.openai.com/v1
ADP_LLM_API_KEY=
ADP_LLM_DEFAULT_MODEL=gpt-4o-mini

# --- VLM model id for scenario C file/live multimodal (optional) ---
# ADP_VLM_MODEL=qwen-vl-plus
# VLM_MODEL=qwen-vl-plus

# --- ROS paths (required for --live) ---
# ADP_ROS_WS=/home/xxx/ros2_ws
# ADP_ROS_WAYPOINTS=/home/xxx/ros2_ws/src/car_nav2/map/waypoints.yaml
# Interpreter that can import rclpy (after sourcing ROS). Avoid ADP-only venv python.
# ADP_ROS_PYTHON=/usr/bin/python3

# --- Optional: local SQLite if you later enable SQL demos ---
# ADP_DB_DSN=sqlite+aiosqlite:///./adp_edge.db

# --- NOT required for current A/B/C demos (voice stack) ---
# DASHSCOPE_API_KEY=
# ASR_MODEL=
# TTS_MODEL=
